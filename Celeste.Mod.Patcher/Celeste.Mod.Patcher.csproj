<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Celeste.Mod.Patcher</AssemblyName>
    <RootNamespace>Celeste.Mod.Patcher</RootNamespace>
    <OutputType>Exe</OutputType>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost> <!-- MiniInstaller will create an AppHost for us -->
    
    <DefineConstants>$(DefineConstants);EVEREST_PATCHER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Celeste.Mod.mm is for compilation, Celeste is for runtime -->
    <InternalsVisibleTo Include="Celeste" />
    <InternalsVisibleTo Include="Celeste.Mod.mm" />

    <Compile Include="..\Celeste.Mod.mm\Mod\Everest\Logger.cs" Link="Logger.cs"/>
    <Compile Include="..\Celeste.Mod.mm\Mod\Helpers\LogWriter.cs" Link="LogWriter.cs"/>
    <Compile Include="..\Celeste.Mod.mm\Mod\Helpers\LogRotationHelper.cs" Link="LogRotationHelper.cs"/>
    <Compile Include="..\Celeste.Mod.mm\Mod\Helpers\IConst.cs" Link="IConst.cs"/>

    <Reference Include="Steamworks.NET">
      <HintPath>..\lib-stripped\Steamworks.NET.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <ProjectReference Include="..\external\MonoMod\src\MonoMod.Patcher\MonoMod.Patcher.csproj" />
    <ProjectReference Include="..\external\MonoMod\src\MonoMod.Utils\MonoMod.Utils.csproj" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
  </ItemGroup>

  <!-- Anonymize paths -->
  <PropertyGroup>
    <PathMap>$(MSBuildProjectDirectory)=Celeste.Mod.Patcher/</PathMap>
  </PropertyGroup>

</Project>
